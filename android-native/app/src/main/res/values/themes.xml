<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Invitations" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorPrimaryVariant">@color/gold_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/config_blue</item>
        <item name="android:statusBarColor">@color/cream_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Invitations.Dark">
        <item name="android:statusBarColor">@color/config_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CardAdrian">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/card_white</item>
    </style>

    <style name="BtnBlue" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/config_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="BtnGold" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/gold_light</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="BtnWhatsApp" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/green_whatsapp</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="InputDark" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/config_border</item>
        <item name="hintTextColor">@color/config_muted</item>
        <item name="android:textColorHint">@color/config_muted</item>
    </style>

    <style name="InputLight" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/gold_light</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>
</resources>
