<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/config_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="end"
            android:alpha="0.85"
            android:contentDescription="@null"
            android:src="@drawable/floral_corner" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textColor="@color/config_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/config_intro"
            android:textColor="@color/config_muted"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/posterPreview"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="20dp"
            android:background="@color/config_border"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/template_sarah" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date (ex: 11 Septembre 2026)"
            app:boxBackgroundColor="@color/config_bg">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/config_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Lieu / Salle"
            app:boxBackgroundColor="@color/config_bg">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/config_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/InputDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Message WhatsApp"
            app:boxBackgroundColor="@color/config_bg">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4"
                android:textColor="@color/config_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Utilisez {NAME}, {DATE} et {VENUE} pour personnaliser."
            android:textColor="@color/config_muted"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/checkEmbedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/config_blue"
            android:checked="true"
            android:text="@string/embed_name"
            android:textColor="@color/config_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/BtnBlue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save_start" />
    </LinearLayout>
</ScrollView>
